# RF Head Refinement Standard v1
# Freeze ID: RF-HEAD-REFINE-STD-V1__20260822
# Frozen on: 2026-08-22
# Evidence run: highrisk_v2_head_refine_20260821T132722Z
#
# Scope:
#   Current NMP-free, two-axis Head refinement standard. The search objective is
#   the Pareto pair (global_risk, positive_mass_density), both lower-is-better.
#   Children must dominate their parent on both axes. The complete realized
#   Pareto frontier is retained; this profile does not introduce a scalar top-1.
#
# Usage:
#   source inverse_folding/reference_flow/configs/rf_refine_head_standard_v1.env
#   sbatch scripts/submit_refine.slurm
#
# The caller must still provide run-specific paths and identities, including
# SEED_TABLE, TEST_SET_PARQUET, PDB_ROOT, HEAD_CHECKPOINT, OUT_DIR, JOB_TAG,
# and CONSTRAINT_MANIFEST. Hard anchors therefore remain dataset-specific.

export MODE=refine
export TARGET_SOURCE=head

# Head proposal geometry.
export HEAD_RESIDUE_THRESHOLD=0.15
export HEAD_MAX_TARGET_POSITIONS=12
export HEAD_AA_PER_POSITION=2
export MAX_PAIRS=200

# Multi-round Pareto beam.
export BEAM_WIDTH=8
export MAX_ROUNDS=6
export PATIENCE=1
export MAX_PATH_MUTATIONS=6

# Candidate/refold bounds. TOPB is retained for launcher compatibility; the
# smaller REFOLD_CAP is the effective per-round structure-evaluation ceiling.
export TOPB=64
export REFOLD_CAP=12

# Frozen structure-compatibility behavior from the evidence run. This is a
# seed-relative legacy gate (scTM_after >= scTM_seed - 0.05), not an absolute
# scTM threshold. Constraint-manifest anchors, when supplied, remain enforced.
export STRUCTURE_GATE_PROFILE=legacy
export SCTM_EPS=0.05
export REFOLD_MODEL=esmfold2_live
export REFINEMENT_STRUCTURE_METRICS=global_ca_rmsd,plddt

# Evaluation emission remains Head + structure only for TARGET_SOURCE=head.
export EMIT_EVAL_METRICS=1
export IMM_FULL=0
export HOTSPOT_THRESHOLD=0.5
